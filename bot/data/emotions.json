{
  "cards": [
    {
      "id": "serenity",
      "name": "Serenity",
      "axis": 0,
      "intensity": 1,
      "keywords": "calm, quiet ease, tranquil stillness",
      "sensation": "Slow, full belly breaths, heavy relaxed limbs, a quieted nervous system, and still thoughts."
    },
    {
      "id": "joy",
      "name": "Joy",
      "axis": 0,
      "intensity": 2,
      "keywords": "contentment, delight, warmth, vitality",
      "sensation": "An easy buoyancy behind the sternum, relaxed shoulders, open posture, and a natural, unforced smile."
    },
    {
      "id": "ecstasy",
      "name": "Ecstasy",
      "axis": 0,
      "intensity": 3,
      "keywords": "euphoria, radiant bliss, uncontainable lightness",
      "sensation": "A surge of heat in the chest, feeling boundless, tingling skin, and an urge to laugh or open wide."
    },
    {
      "id": "acceptance",
      "name": "Acceptance",
      "axis": 1,
      "intensity": 1,
      "keywords": "tolerance, soft surrender, welcome, neutrality",
      "sensation": "Soft exhalation, unclenched hands, letting go of resistance to the present moment."
    },
    {
      "id": "trust",
      "name": "Trust",
      "axis": 1,
      "intensity": 2,
      "keywords": "safety, receptivity, acceptance, faith",
      "sensation": "Releasing the clenched jaw, dropping the defensive guard, a steady heartbeat, and an impulse to lean in."
    },
    {
      "id": "admiration",
      "name": "Admiration",
      "axis": 1,
      "intensity": 3,
      "keywords": "reverence, profound respect, devotion, esteem",
      "sensation": "A warm lift in the chest, open gaze, feeling small yet elevated in the presence of something noble."
    },
    {
      "id": "apprehension",
      "name": "Apprehension",
      "axis": 2,
      "intensity": 1,
      "keywords": "unease, mild worry, hesitation, doubt",
      "sensation": "A faint knot in the stomach, tense shoulders, and a cautious pause before stepping forward."
    },
    {
      "id": "fear",
      "name": "Fear",
      "axis": 2,
      "intensity": 2,
      "keywords": "fright, alarm, danger, vulnerability",
      "sensation": "A rapid pulse, cool sweat on the palms, tightness in the gut, and dilated, scanning eyes."
    },
    {
      "id": "terror",
      "name": "Terror",
      "axis": 2,
      "intensity": 3,
      "keywords": "horror, sheer panic, petrification, dread",
      "sensation": "A cold jolt down the spine, breath seizing in the throat, adrenaline spiking, and an instinct to flee or freeze."
    },
    {
      "id": "distraction",
      "name": "Distraction",
      "axis": 3,
      "intensity": 1,
      "keywords": "diverted focus, fleeting curiosity, wander, shift",
      "sensation": "Restless eyes, thoughts drifting off course, and a light detachment from the immediate task."
    },
    {
      "id": "surprise",
      "name": "Surprise",
      "axis": 3,
      "intensity": 2,
      "keywords": "startle, suddenness, unexpectedness, shock",
      "sensation": "A quick involuntary blink, a brief flutter in the chest, and an abrupt pause in train of thought."
    },
    {
      "id": "amazement",
      "name": "Amazement",
      "axis": 3,
      "intensity": 3,
      "keywords": "astonishment, wonder, stunned awe, disbelief",
      "sensation": "Dropped jaw, wide eyes, a sharp intake of breath, and a sudden stillness as reality resets."
    },
    {
      "id": "pensiveness",
      "name": "Pensiveness",
      "axis": 4,
      "intensity": 1,
      "keywords": "melancholy, reflective quiet, wistfulness, stillness",
      "sensation": "A low-energy hum, downward gaze, slow steady breaths, and a longing pull toward solitude."
    },
    {
      "id": "sadness",
      "name": "Sadness",
      "axis": 4,
      "intensity": 2,
      "keywords": "ache, sorrow, heaviness, mourning",
      "sensation": "A tight knot in the throat, burning behind the eyes, sunken posture, and a hollow weight in the gut."
    },
    {
      "id": "grief",
      "name": "Grief",
      "axis": 4,
      "intensity": 3,
      "keywords": "anguish, heartbreak, devastating loss, desolation",
      "sensation": "A crushing heaviness on the chest, burning throat, hollow ache in the abdomen, and ragged, sob-laden breath."
    },
    {
      "id": "boredom",
      "name": "Boredom",
      "axis": 5,
      "intensity": 1,
      "keywords": "apathy, disinterest, dullness, fatigue",
      "sensation": "Heavy eyelids, slack posture, frequent sighs, and a sluggish lack of sensory engagement."
    },
    {
      "id": "disgust",
      "name": "Disgust",
      "axis": 5,
      "intensity": 2,
      "keywords": "distaste, aversion, distaste, rejection",
      "sensation": "Wrinkled nose, retracted chin, sour taste in the mouth, and an instinctive physical pull backward."
    },
    {
      "id": "loathing",
      "name": "Loathing",
      "axis": 5,
      "intensity": 3,
      "keywords": "abhorrence, deep disgust, revulsion, repulse",
      "sensation": "A violent churn in the stomach, curling upper lip, bile rising, and an urgent impulse to push away."
    },
    {
      "id": "annoyance",
      "name": "Annoyance",
      "axis": 6,
      "intensity": 1,
      "keywords": "irritation, prickle, impatience, friction",
      "sensation": "A short, sharp exhale through the nose, twitching brow, and restless, tight fingers."
    },
    {
      "id": "anger",
      "name": "Anger",
      "axis": 6,
      "intensity": 2,
      "keywords": "indignation, frustration, boundary defense, heat",
      "sensation": "Locked jaw, hardened stare, tight shoulders, and heat gathering across the chest and forehead."
    },
    {
      "id": "rage",
      "name": "Rage",
      "axis": 6,
      "intensity": 3,
      "keywords": "fury, wrath, blinding anger, explosive force",
      "sensation": "Blood pounding in the temples, clenched fists, flushed hot skin, and an intense surge of adrenaline demanding release."
    },
    {
      "id": "interest",
      "name": "Interest",
      "axis": 7,
      "intensity": 1,
      "keywords": "attentiveness, engagement, awareness, curiosity",
      "sensation": "Tilted head, soft focus, relaxed posture, and an easy, sustained pull toward an object or idea."
    },
    {
      "id": "anticipation",
      "name": "Anticipation",
      "axis": 7,
      "intensity": 2,
      "keywords": "expectation, looking forward, preparation, suspense",
      "sensation": "A buoyant flutter in the diaphragm, leaning forward on the toes, and a racing, proactive mind."
    },
    {
      "id": "vigilance",
      "name": "Vigilance",
      "axis": 7,
      "intensity": 3,
      "keywords": "hyper-alertness, keen readiness, intense focus, watchfulness",
      "sensation": "Erect spine, zero blink rate, shallow poised breathing, and all senses tuned to a razor point."
    }
  ],
